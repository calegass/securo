DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securo
# Required in production (DEBUG=false): generate a random value with
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
DEBUG=true
# Optional deployment-wide fallback. User-owned Pluggy credentials are stored
# encrypted in the database via the Accounts screen.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0

# Optional SMTP notifications. TLS uses STARTTLS (normally port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Brazilian Treasury bond prices. On by default; set to false to disable
# (e.g. to avoid the dependency on the Brazilian government CSV endpoint).
TESOURO_DIRETO_ENABLED=true

# Optional OIDC login (Authentik, Pocket ID, or standard OIDC providers)
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=OIDC
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to ${FRONTEND_URL}/api/auth/oidc/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_AUTO_REGISTER=true
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Set to false only with OIDC_ENABLED=true, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL configured
LOCAL_AUTH_ENABLED=true
OIDC_SYNC_ROLES=false
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_ROLES=
OIDC_WORKSPACE_ROLE_MAP=
